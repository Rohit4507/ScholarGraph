# ── ScholarGraph AI — Environment Variables ──
# Copy this file to .env and fill in your values

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here

# Pinecone
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_INDEX_NAME=scholargraph
PINECONE_ENVIRONMENT=us-east-1

# JWT Authentication
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this

# Database (use SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./scholargraph.db
# POSTGRES_URL=postgresql://user:password@localhost:5432/scholargraph

# Redis (optional for caching)
REDIS_URL=redis://localhost:6379/0

# App Settings
DEBUG=true
HOST=0.0.0.0
PORT=8000
